{
  "name": "ai-skills-catalog-server",
  "version": "2.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "html"
    ]
  },
  "jest-junit": {
    "outputDirectory": "../../../artifacts/verify",
    "outputName": "test-results-backend-2.xml"
  }
}
